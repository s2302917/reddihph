Options -Indexes
DirectoryIndex index.php
RewriteEngine On

RewriteRule ^\. - [F,NC,L]
RewriteRule ^(?!index\.php$).+\.php$ - [F,NC,L]
RewriteRule ^$ index.php [QSA,END]
RewriteRule ^assets/(css|js)/[A-Za-z0-9_-]+\.(?:css|js)$ index.php [QSA,END]
RewriteRule ^assets/ - [F,NC,L]
RewriteRule ^ index.php [QSA,END]
